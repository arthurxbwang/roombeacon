[Unit]
Description=RoomBeacon isolated persistent Redis
After=network.target
RequiresMountsFor=/data/roombeacon

[Service]
Type=simple
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /data/roombeacon/shared/redis.conf
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/roombeacon/shared/redis

[Install]
WantedBy=multi-user.target
