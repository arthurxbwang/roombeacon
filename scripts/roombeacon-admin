#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then
    echo 'Run as root to manage local display credentials.' >&2
    exit 1
fi
set -a
. /etc/roombeacon/service.env
. /etc/roombeacon/feishu.env
set +a
cd /opt/roombeacon/backend
exec /opt/roombeacon-venv/bin/python -m app.services.room_display_admin "$@"
