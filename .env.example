# Copy to .env for local development only. Never commit real values.
APP_ENV=dev
REDIS_URL=redis://127.0.0.1:6379/0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
ROOM_DISPLAY_SYNC_SECONDS=300
ROOM_DISPLAY_CONTROL_TOKEN=
ROOM_DISPLAY_CONTROL_TOKEN_SECONDARY=
ROOM_DISPLAY_CHECKIN_URLS={}
# V5：默认关闭；开启确认与观察不等于允许飞书释放。
ROOM_DISPLAY_USAGE_ENABLED=false
ROOM_DISPLAY_USAGE_WRITES_ENABLED=false

# 只有列入服务器白名单的房间可执行释放；空列表禁止所有房间写入。
ROOM_DISPLAY_USAGE_RELEASE_ROOM_IDS=[]
# V5 固定来源兼容配置；未启用按组织者解析时仍只使用此映射。
# JSON 对象示例 {"omm_专用测试房间ID":"可读取的测试日历ID"}。
ROOM_DISPLAY_USAGE_AUTO_VERIFY_CALENDARS={}
# 按每场预约的组织者解析来源，默认关闭；必须同时位于释放房间白名单。
# JSON 列表示例 ["omm_专用测试房间ID"]；需要应用读取该组织者主日历和实际日程的权限。
# 两项来源配置均为空时保留逐实例登记；配置不代表每场预约已核验。
ROOM_DISPLAY_USAGE_ORGANIZER_SOURCE_ROOM_IDS=[]

# V6 持久设备管理；生产使用独立可写目录，不放在 releases 内
ROOM_DISPLAY_V6_DB=
ROOM_DISPLAY_PUBLIC_ORIGIN=https://roombeacon.thundersoft.com
# 配置飞书网页应用回调后启用；登录者仍需后台手动授权
ROOM_DISPLAY_FEISHU_LOGIN_ENABLED=false
ROOM_DISPLAY_FEISHU_TENANT_KEY=
# 仅明确授权的首次部署开启；数据库保存消费记录，不因管理员被停用而再次初始化
ROOM_DISPLAY_FEISHU_BOOTSTRAP_ADMIN_ONCE=false
